// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Window-Rules

// Tip: to get "app-id", run `niri msg windows` when the windows are open.

// Enable rounded corners for all windows.
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

window-rule {
    match app-id="waybar"
    // This prevents Niri from trying to "animate" the bar window itself.
    geometry-corner-radius 0
}

// Open as a full-width window.
window-rule {
    match app-id="^firefox$"
    match app-id="^google-chrome$"
    match app-id="^steam$"
    default-column-width {
        proportion 1.0
    }
}

// Open as a half-width window.
window-rule {
    match app-id="^org.pwmt.zathura$"
    match app-id="^anki$" title="^user-1 - Anki"
    default-column-width {
        proportion 0.5
    }
}

// Open as a floating window.
window-rule {
    match app-id="^imv$"
    match app-id="^anki$" title="^Add$"
    match app-id="^blender$" title="^Preferences$"
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}

// Open in fullscreen.
window-rule {
    match app-id=r#"steam_app_\d+"#
    open-fullscreen true
}

// Chrome plugins.
window-rule {
    match app-id="^chrome-"
    exclude title="^Monkeytype"
    exclude title="^Telegram"
    exclude title="^WhatsApp"
    open-floating true
}

// Block out two password managers from screen capture.
window-rule {
    match app-id="^org\\.keepassxc\\.KeePassXC$"
    match app-id="^org\\.gnome\\.World\\.Secrets$"
    block-out-from "screen-capture"
    // // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}
